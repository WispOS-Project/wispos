#!/bin/sh
# commit-msg hook: every commit is tied to a GitHub issue, in the subject
# style the project already uses. Installed by tools/install-hooks.sh
# (git config core.hooksPath tools/githooks). Merge commits are exempt:
# GitHub writes those, not us. Anything else rejected explains itself.
file="$1"
# Git drops comment lines only when the effective cleanup mode is `strip`, and
# the default depends on how the message arrived: `git commit -m` and `-F` never
# open an editor and default to `whitespace`, which keeps them. Stripping in
# that case makes the hook judge a different message than Git stores, so a
# comment-shaped first line passes as a conforming subject while the commit's
# real subject is the comment. `commit.cleanup` overrides the default, and no
# editor ran when Git hands us GIT_EDITOR=: (probe-cleanup-modes.sh).
#
# KNOWN LIMITATION, accepted deliberately: `GIT_EDITOR=:` is the only signal this
# hook has for "no editor ran", and a `--cleanup` given on the command line is
# invisible here (git exports no variable naming it). Both were measured on git
# 2.43, where git sets `:` for every no-editor form and overwrites a caller's own
# GIT_EDITOR, so the common paths are exact; a future git that skips the editor
# without setting `:`, or an explicit `--cleanup=whitespace -e`, would still let a
# comment-shaped subject through. Nothing inside commit-msg can close that,
# because the hook never sees the stored message: the enforceable check is a
# ref or push boundary reading `git log --format=%B` (#31).
cleanup=$(git config --get commit.cleanup 2>/dev/null || true)
# git validates commit.cleanup itself, so only these five values reach the hook;
# an unset strip_comments means "treat the text as content", which fails closed.
case "$cleanup" in
    strip) strip_comments=1 ;;
    # scissors is whitespace-plus-truncation, not comment removal, so it keeps
    # comments along with verbatim and whitespace.
    verbatim|whitespace|scissors) strip_comments=0 ;;
    ""|default) if [ "${GIT_EDITOR:-}" = ":" ]; then strip_comments=0; else strip_comments=1; fi ;;
esac
# Git only appends a verbose template (comment lines plus a diff after a scissor
# marker) when it opens an editor, and it truncates there too. Under `-m`/`-F`
# such a marker is ordinary text that Git stores, so cutting on it would drop a
# real footer and reject a valid commit - verified against `commit.cleanup` set to
# scissors both by config and by CLI flag: the message was stored whole.
if [ "${GIT_EDITOR:-}" = ":" ]; then edited=0; else edited=1; fi
# Two separate questions, and collapsing them breaks one while fixing the other:
# whether Git truncates at the scissor marker (only in the edited path, where Git
# itself appended a verbose template) and whether it removes comment lines (the
# cleanup mode, which `strip` also does under `-m`). A `Refs` line below either
# dropped section must not satisfy the issue-link check.
#
# Neither is keyed to '#'. Git writes its comment lines AND its scissor line with
# the character from core.commentChar; only when it is unset is that '#'. So
# anchoring either step on a literal '#' both counted a footer Git had thrown
# away (with commentChar=';' or '!', whose ';' and '!' marker went unrecognized,
# so the text under it was judged although Git discards it) and rejected a footer
# Git had kept (a '#'-prefixed marker is ordinary text when the character is
# ';'). Measured on git 2.43, this is issue #30.
#
# `auto` is settled by Git while it writes the template, from the message as it
# was BEFORE the editor ran (adjust_comment_line_char, builtin/commit.c), so the
# character cannot be recomputed here: the buffer that decided it is gone, and
# reading it off the template text instead would let a planted line above Git's
# own choose the wrong character and hide the real cut - failing open. So under
# `auto` the hook cuts at the first marker-shaped line of ANY single character
# and removes no comment lines. Git's own marker is one of those, so this can
# only cut at or above where Git cuts, and a footer below Git's marker can never
# be counted. The cost is a false rejection when a message carries such a line
# for a character Git did not choose - the safe direction for a validator.
marker=' ------------------------ >8 ------------------------'
configured=$(git config --get core.commentChar 2>/dev/null || true)
auto_char=0
comment_char='#'
case "$configured" in
    ''|'#') : ;;
    auto) auto_char=1 ;;
    ?) comment_char="$configured" ;;
    # Git refuses a value that is not one character before any hook runs, so
    # this branch is defence in depth; treat it like the unknowable case.
    *) auto_char=1 ;;
esac
if [ "$edited" = 1 ]; then
    if [ "$auto_char" = 1 ]; then
        # substr from the 2nd character equal to the whole marker implies the
        # line is exactly one character plus that marker: no length arithmetic,
        # and no regex, so a marker character that is regex-special is safe.
        body=$(WISP_MARK="$marker" \
            awk 'substr($0, 2) == ENVIRON["WISP_MARK"] { exit } { print }' "$file")
    else
        body=$(WISP_MARK="$comment_char$marker" \
            awk '$0 == ENVIRON["WISP_MARK"] { exit } { print }' "$file")
    fi
else
    body=$(cat "$file")
fi
if [ "$strip_comments" = 1 ] && [ "$auto_char" = 0 ]; then
    body=$(printf '%s\n' "$body" | WISP_CHAR="$comment_char" \
        awk 'index($0, ENVIRON["WISP_CHAR"]) != 1')
fi
body=$(printf '%s\n' "$body" | sed '/[^[:space:]]/,$!d')
subject=$(printf '%s\n' "$body" | head -n 1)
case "$subject" in
    Merge\ *)
        if git rev-parse --verify -q MERGE_HEAD >/dev/null 2>&1; then exit 0; fi
        ;;
esac
# printf, never echo: where /bin/sh is dash, echo expands backslash escapes
# before grep sees the subject, so 'docs\072 forged' would pass as 'docs: forged'
# while Git stores the nonconforming literal text. The summary must start with a
# non-space character: under `cleanup=verbatim` Git keeps trailing whitespace, so
# `: .+` would let 'docs:  ' pass with no summary at all.
printf '%s\n' "$subject" | grep -Eq '^(feat|fix|refactor|chore|docs|test|release)(\([^)]+\))?: [^[:space:]]' || {
    echo "commit rejected: subject must be 'type[(scope)]: imperative summary'" >&2
    echo "  types: feat fix refactor chore docs test release" >&2
    exit 1
}
printf '%s\n' "$body" | grep -Eq '^(Refs|Fixes|Closes|Resolves) #[1-9][0-9]*[[:space:]]*$' || {
    echo "commit rejected: no issue link (need 'Refs #N', or 'Fixes/Closes/Resolves #N' to close it on merge)" >&2
    exit 1
}
