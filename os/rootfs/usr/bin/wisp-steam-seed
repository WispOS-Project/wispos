#!/usr/bin/python3
"""WispOS: make Steam's global default compatibility tool the ARM64 Proton, before every Steam start (run by wisp-steam-session; Steam must not be running).
Which tool: our own custom tool `Proton11-ARM64-A57-v80` (the community standalone ARMv8.0 build, installed under compatibilitytools.d; Steam never validates or
updates a custom tool, whereas Valve's own `Proton 11.0 (ARM64)` is re-validated and updated by Steam, which undoes any change made to it: docs/WISPOS-NOTES.md,
"DESIGN FINDING") when it is installed, otherwise Valve's `proton-stable`. A default we seeded earlier (`proton-stable`, priority 75) is upgraded to the custom
tool once it exists; any other default (the user's own choice) is never touched.

Why: with no default, Steam queues the x86 "Proton Experimental" + FEX + a second runtime (about 2.2 GB) that cannot run on this device (the FEX path needs a guest
rootfs and graphics provider this image does not have; docs/WISPOS-NOTES.md, Worms Armageddon install) and then fetches the ARM64 stack only when told per game.
What it does: in config.vdf, InstallConfigStore/Software/Valve/Steam/CompatToolMapping, add the global entry "0" = proton-stable if there is no entry "0". An existing
"0" entry (the user's own choice in Steam's settings) is never touched. Everything else in the file is left as it is (text edit, not a rewrite). If no config.vdf
exists yet (first start) a minimal one is written; Steam fills in the rest.
Third job (issue #36): per-app mappings. Steam resolves the tool PER APPID and the global "0" default never beats a per-app mapping (measured 2026-10-19/20: Counter-Strike and Quake III ran Valve's stock Proton, which hangs in wineboot on this CPU). With the custom tool installed, an entry "<AppID>" = custom tool at SEED_PRIORITY is added for every app Steam's own compat log shows mapped to proton-stable/proton-experimental. Priorities compete only inside one AppID: 200 beats Steam's 85, and a person's own choice (250, written by Steam's settings over the same key) wins; an existing entry is never touched. Known limit: an app first seen while Steam runs is covered from the next start.
Second job, the SteamOS UI scale (operator decision 2026-10-15: "150 %" = his own 9-notch hand pick, ScaleFactor 0.842373907566070557 = 1.45 x Steam's auto value on this panel; Steam's
control shows no percentage): Steam stores a manual UI scale as a per-display block under InstallConfigStore/UI/display, named "<display>|||<mode>" ("External: DSI-1 3\"|||Fullscreen-720x480"
on this device), holding ScaleFactor; its mere presence switches "Automatically Scale User Interface" off and Steam mirrors the value into display/Current. The seed adds that block when
no per-display block with a ScaleFactor exists (a user's own choice, any name, is never touched; Steam's own Current block does not count and is not edited). Verified on the handheld
2026-10-15 (docs/WISPOS-NOTES.md "UI scale seed"): a config holding only the seeded block started Steam normally, in the same 47 s as without it, and the UI was larger.
usage: wisp-steam-seed [CONFIG_VDF]   (default /storage/wispos/home/.local/share/Steam/config/config.vdf)   exit 0 = fine (seeded or nothing to do), 1 = file not understood (left alone)
"""
import os, re, sys

DEFAULT = '/storage/wispos/home/.local/share/Steam/config/config.vdf'
STEAM_ROOT = '/storage/wispos/runtime/steam'
CUSTOM_TOOL = 'Proton11-ARM64-A57-v80'          # the internal name in its compatibilitytool.vdf
# Our signature: a default with this priority was written by us. It must outrank Valve's own recommendations: in SteamOS mode (-steamos3) Steam records a per-game mapping "at priority 85 to tool
# proton-stable" for every game it knows (compat_log.txt, measured 2026-10-14), and a per-game mapping beats a global default of lower priority, so with 75 every game was launched with
# Valve's STOCK Proton, which spins in wineboot on this CPU (docs/WISPOS-NOTES.md). 200 beats 85 and stays below 250, the priority of a person's own explicit choice in Steam's settings.
SEED_PRIORITY = '200'
LEGACY_PRIORITY = '75'                          # what earlier versions wrote; upgraded in place


def entry(tool):
    return '"0"\n{\n\t"name"\t\t"%s"\n\t"config"\t\t""\n\t"priority"\t\t"%s"\n}\n' % (tool, SEED_PRIORITY)


def wanted_tool(steam_root=STEAM_ROOT):
    """The custom tool when it is installed, else Valve's."""
    return CUSTOM_TOOL if os.path.exists(os.path.join(steam_root, 'compatibilitytools.d', CUSTOM_TOOL, 'compatibilitytool.vdf')) else 'proton-stable'


def indent(block, tabs):
    return ''.join(('\t' * tabs + l if l.strip() else l) for l in block.splitlines(True))


def mapping_block(tabs, tool):
    return indent('"CompatToolMapping"\n{\n' + indent(entry(tool), 1) + '}\n', tabs)


def minimal(tool):
    inner = mapping_block(0, tool)
    for key in ('Steam', 'Valve', 'Software', 'InstallConfigStore'):
        inner = '"%s"\n{\n%s}\n' % (key, indent(inner, 1))
    return inner


def block_end(lines, open_idx):
    """Index of the line holding the brace that closes the block opened at lines[open_idx] ('{')."""
    depth = 0
    for i in range(open_idx, len(lines)):
        s = lines[i].strip()
        if s == '{': depth += 1
        elif s == '}':
            depth -= 1
            if depth == 0: return i
    return None


def find_block(lines, name, start=0, stop=None):
    """(key_idx, open_idx, close_idx) of the first direct-or-nested block called name between start and stop, or None."""
    stop = len(lines) if stop is None else stop
    for i in range(start, stop - 1):
        if lines[i].strip() == '"%s"' % name and lines[i + 1].strip() == '{':
            end = block_end(lines, i + 1)
            if end is not None: return i, i + 1, end
    return None


def seed(text, tool='proton-stable'):
    """(new text, status): 'seeded' (entry added), 'upgraded' (our own earlier proton-stable seed now points at `tool`), 'present' (a default exists; left alone)
    or 'unrecognised' (text returned unchanged)."""
    if not text.strip(): return minimal(tool), 'seeded'
    lines = text.splitlines(True)
    if not lines[-1].endswith('\n'): lines[-1] += '\n'
    steam = None
    here = (0, len(lines))
    for name in ('InstallConfigStore', 'Software', 'Valve', 'Steam'):
        b = find_block(lines, name, *here)
        if b is None: return text, 'unrecognised'
        here = (b[1] + 1, b[2]); steam = b
    key, op, cl = steam
    depth = len(lines[key]) - len(lines[key].lstrip('\t')) + 1
    cm = find_block(lines, 'CompatToolMapping', op + 1, cl)
    if cm is None:
        lines[op + 1:op + 1] = [mapping_block(depth, tool)]
        return ''.join(lines), 'seeded'
    ckey, cop, ccl = cm
    d, i = 0, cop + 1
    while i < ccl:                              # direct children of the mapping block: is there an entry "0"?
        s = lines[i].strip()
        if s == '{': d += 1
        elif s == '}': d -= 1
        elif d == 0 and s == '"0"':
            end = block_end(lines, i + 1) if lines[i + 1].strip() == '{' else None
            if end is None: return text, 'present'
            fields = {}
            for j in range(i + 2, end):
                m = re.match(r'^\s*"(name|priority)"\s+"([^"]*)"\s*$', lines[j])
                if m: fields[m.group(1)] = (j, m.group(2))
            name, prio = fields.get('name', (0, ''))[1], fields.get('priority', (0, ''))[1]
            ours = name in ('proton-stable', CUSTOM_TOOL) and prio in (LEGACY_PRIORITY, SEED_PRIORITY)       # anything else is the user's own choice: never touched
            if ours and (name != tool or prio != SEED_PRIORITY):
                if name != tool:
                    j = fields['name'][0]
                    lines[j] = lines[j].replace('"%s"' % name, '"%s"' % tool, 1)
                if prio != SEED_PRIORITY:
                    j = fields['priority'][0]
                    lines[j] = re.sub(r'^(\s*"priority"\s+")[^"]*(")', lambda m: m.group(1) + SEED_PRIORITY + m.group(2), lines[j], count=1)
                return ''.join(lines), 'upgraded'
            return text, 'present'
        i += 1
    lines[cop + 1:cop + 1] = [indent(entry(tool), depth + 2)]
    return ''.join(lines), 'seeded'


# Apps whose per-app mapping Steam itself records (compat_log.txt: "Recording non-user mapping for N at priority P to tool T") for tools that run Windows games through Proton.
# `native` (Linux builds) and Valve's runtimes are not Windows-through-Proton choices and stay as Steam has them.
PROTON_TOOLS = ('proton-stable', 'proton-experimental')
MAPPING_RE = re.compile(r'Recording non-user mapping for (\d+) at priority \d+ to tool ([A-Za-z0-9_.-]+)')


def mapped_apps(log_texts):
    """Sorted AppIDs that Steam's own mapping sends to one of PROTON_TOOLS, read from the compat log text(s)."""
    ids = set()
    for text in log_texts:
        for m in MAPPING_RE.finditer(text):
            if m.group(2) in PROTON_TOOLS: ids.add(int(m.group(1)))
    return sorted(ids)


def seed_apps(text, ids, tool):
    """(new text, count): an entry "<AppID>" = `tool` at SEED_PRIORITY for every id that has none in CompatToolMapping. An existing entry (a person's own choice in Steam's settings,
    or ours from an earlier start) is never touched. Needs the CompatToolMapping block to exist (seed() creates it); otherwise (text, 0)."""
    lines = text.splitlines(True)
    ics = find_block(lines, 'InstallConfigStore')
    if ics is None: return text, 0
    steam = ics
    here = (ics[1] + 1, ics[2])
    for name in ('Software', 'Valve', 'Steam'):
        b = find_block(lines, name, *here)
        if b is None: return text, 0
        here = (b[1] + 1, b[2]); steam = b
    cm = find_block(lines, 'CompatToolMapping', steam[1] + 1, steam[2])
    if cm is None: return text, 0
    ckey, cop, ccl = cm
    depth = len(lines[ckey]) - len(lines[ckey].lstrip('\t')) + 1
    have = {lines[b[0]].strip().strip('"') for b in child_blocks(lines, cop, ccl)}
    new = [i for i in sorted(set(ids)) if str(i) not in have]
    if not new: return text, 0
    lines[ccl:ccl] = [indent(entry(tool).replace('"0"', '"%d"' % i, 1), depth) for i in new]
    return ''.join(lines), len(new)


def read_logs(config_path):
    base = os.path.join(os.path.dirname(os.path.dirname(config_path)), 'logs')
    out = []
    for name in ('compat_log.previous.txt', 'compat_log.txt'):
        try:
            with open(os.path.join(base, name), encoding='utf-8', errors='replace') as f: out.append(f.read())
        except OSError: pass
    return out


UI_SCALE_DISPLAY = 'External: DSI-1 3"|||Fullscreen-720x480'     # Steam's name for this panel in its normal Game-mode start (measured 2026-10-15)
UI_SCALE = '0.842373907566070557'


def ui_block(tabs):
    """The per-display block as text, indented by `tabs` (the quote inside the name is escaped the way Steam writes it)."""
    name = UI_SCALE_DISPLAY.replace('"', '\\"')
    return indent('"%s"\n{\n\t"ScaleFactor"\t\t"%s"\n}\n' % (name, UI_SCALE), tabs)


def child_blocks(lines, op, cl):
    """(key_idx, open_idx, close_idx) of the direct child blocks between the braces at op and cl."""
    out, i = [], op + 1
    while i < cl - 1:
        if lines[i + 1].strip() == '{' and lines[i].strip().startswith('"'):
            end = block_end(lines, i + 1)
            if end is None: break
            out.append((i, i + 1, end)); i = end + 1
        else:
            i += 1
    return out


def seed_ui_scale(text):
    """(new text, status): 'seeded' (the per-display block added), 'present' (a per-display block with a ScaleFactor exists, whatever its name: left alone) or 'unrecognised'."""
    lines = text.splitlines(True)
    if not lines: return text, 'unrecognised'
    if not lines[-1].endswith('\n'): lines[-1] += '\n'
    ics = find_block(lines, 'InstallConfigStore')
    if ics is None: return text, 'unrecognised'
    key, op, cl = ics
    depth = len(lines[key]) - len(lines[key].lstrip('\t')) + 1
    ui = next((b for b in child_blocks(lines, op, cl) if lines[b[0]].strip() == '"UI"'), None)
    if ui is None:
        lines[cl:cl] = [indent('"UI"\n{\n\t"display"\n\t{\n' + ui_block(2) + '\t}\n}\n', depth)]
        return ''.join(lines), 'seeded'
    disp = next((b for b in child_blocks(lines, ui[1], ui[2]) if lines[b[0]].strip() == '"display"'), None)
    if disp is None:
        lines[ui[2]:ui[2]] = [indent('"display"\n{\n' + ui_block(1) + '}\n', depth + 1)]
        return ''.join(lines), 'seeded'
    for b in child_blocks(lines, disp[1], disp[2]):                 # a user's (or an earlier) per-display choice: anything but Steam's own Current block
        if lines[b[0]].strip() == '"Current"': continue
        if any(re.match(r'^\s*"ScaleFactor"\s+"', lines[j]) for j in range(b[1] + 1, b[2])): return text, 'present'
    lines[disp[2]:disp[2]] = [ui_block(depth + 2)]
    return ''.join(lines), 'seeded'


def main(argv):
    path = argv[0] if argv else DEFAULT
    steam_root = argv[1] if len(argv) > 1 else STEAM_ROOT
    old = open(path, encoding='utf-8').read() if os.path.exists(path) else ''
    tool = wanted_tool(steam_root)
    new, status = seed(old, tool)
    if status == 'unrecognised':
        print('wisp-steam-seed: %s has an unexpected structure; left alone' % path); return 1
    new, scale = seed_ui_scale(new)
    if scale == 'unrecognised':
        print('wisp-steam-seed: %s has no InstallConfigStore for the UI scale; left alone' % path); scale = 'present'
    apps = 0
    if tool == CUSTOM_TOOL:                     # only our own tool is worth steering games to; Valve's proton-stable is already what Steam picks
        new, apps = seed_apps(new, mapped_apps(read_logs(path)), tool)
    if status in ('seeded', 'upgraded') or scale == 'seeded' or apps:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        mode = os.stat(path).st_mode & 0o777 if os.path.exists(path) else 0o644
        tmp = path + '.wisp-seed'
        with open(tmp, 'w', encoding='utf-8') as f: f.write(new)
        os.chmod(tmp, mode); os.replace(tmp, path)
    print('wisp-steam-seed: default compatibility tool %s; UI scale %s' % ({'seeded': 'set to ' + tool, 'upgraded': 'moved to ' + tool}.get(status, 'already chosen'), 'seeded' if scale == 'seeded' else 'already chosen') + '; per-app mappings added: %d' % apps)
    return 0


if __name__ == '__main__': sys.exit(main(sys.argv[1:]))
